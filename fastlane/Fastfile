default_platform(:ios)

# The ios/ directory is generated by `expo prebuild` at build time and is not
# committed, so the project name is discovered rather than hardcoded.
def ios_workspace
  Dir["ios/*.xcworkspace"].first ||
    UI.user_error!("No .xcworkspace under ios/ — did `expo prebuild` run?")
end

def ios_project
  Dir["ios/*.xcodeproj"].first ||
    UI.user_error!("No .xcodeproj under ios/ — did `expo prebuild` run?")
end

platform :ios do
  desc "Build the app and upload it to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      # The .p8 is a plain PEM file and GitHub secrets accept multi-line
      # values, so it is pasted verbatim rather than base64-encoded.
      key_content: ENV.fetch("ASC_KEY_P8"),
      is_key_content_base64: false,
      in_house: false
    )

    # Creates and unlocks a temporary keychain. Without this, signing fails on
    # a fresh runner because there is no unlocked keychain to import into.
    setup_ci if ENV["CI"]

    get_certificates(api_key: api_key, development: false)
    get_provisioning_profile(api_key: api_key, development: false)

    scheme = File.basename(ios_workspace, ".xcworkspace")
    UI.message("Detected Xcode scheme: #{scheme}")

    # app.json pins buildNumber to a static value, which App Store Connect
    # rejects on the second upload of a given version. GITHUB_RUN_NUMBER is
    # monotonic, so each build gets a number Apple has not seen before.
    increment_build_number(
      xcodeproj: ios_project,
      build_number: ENV.fetch("GITHUB_RUN_NUMBER")
    )

    build_app(
      workspace: ios_workspace,
      scheme: scheme,
      configuration: "Release",
      export_method: "app-store"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
