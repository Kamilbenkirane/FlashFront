default_platform(:ios)

APP_IDENTIFIER = "com.kams96.FlashFrontKB24".freeze
PROFILE_NAME = "match AppStore #{APP_IDENTIFIER}".freeze

# The ios/ directory is generated by `expo prebuild` at build time and is not
# committed, so the project name is discovered rather than hardcoded.
def ios_workspace
  Dir["ios/*.xcworkspace"].first ||
    UI.user_error!("No .xcworkspace under ios/ — did `expo prebuild` run?")
end

def ios_project
  Dir["ios/*.xcodeproj"].first ||
    UI.user_error!("No .xcodeproj under ios/ — did `expo prebuild` run?")
end

platform :ios do
  desc "Build the app and upload it to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      # The .p8 is a plain PEM file and GitHub secrets accept multi-line
      # values, so it is pasted verbatim rather than base64-encoded.
      key_content: ENV.fetch("ASC_KEY_P8"),
      is_key_content_base64: false,
      in_house: false
    )

    # Creates and unlocks a temporary keychain. Without this, signing fails on
    # a fresh runner because there is no unlocked keychain to import into.
    setup_ci if ENV["CI"]

    # Keeps one distribution certificate encrypted in a private git repo and
    # reuses it on every run. The `cert` action cannot do this: a clean runner
    # never holds the existing certificate's private key, so it would mint a
    # new certificate each run, and Apple caps those at two per team — which
    # would eventually force revoking the one already shipping this app.
    # First run creates and stores; later runs just fetch. No Mac required.
    match(
      type: "appstore",
      app_identifier: APP_IDENTIFIER,
      api_key: api_key,
      git_url: ENV.fetch("MATCH_GIT_URL"),
      readonly: false
    )

    scheme = File.basename(ios_workspace, ".xcworkspace")
    UI.message("Detected Xcode scheme: #{scheme}")

    # `expo prebuild` emits a project set to automatic signing. match supplies
    # profiles explicitly, so the target must be switched to manual or Xcode
    # will ignore them and try to provision on its own.
    update_code_signing_settings(
      path: ios_project,
      use_automatic_signing: false,
      team_id: ENV["sigh_#{APP_IDENTIFIER}_appstore_team-id"],
      code_sign_identity: "Apple Distribution",
      profile_name: PROFILE_NAME,
      bundle_identifier: APP_IDENTIFIER
    )

    # app.json pins buildNumber to a static value, which App Store Connect
    # rejects on the second upload of a given version. GITHUB_RUN_NUMBER is
    # monotonic, so each build gets a number Apple has not seen before.
    increment_build_number(
      xcodeproj: ios_project,
      build_number: ENV.fetch("GITHUB_RUN_NUMBER")
    )

    build_app(
      workspace: ios_workspace,
      scheme: scheme,
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: { APP_IDENTIFIER => PROFILE_NAME }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
